# Copy to .env (gitignored) or export in your shell.
# Pick ONE auth mode. The scripts try in this order:
#   1. JIRA_EMAIL + JIRA_API_TOKEN   (Cloud — most common)
#   2. JIRA_OAUTH_TOKEN              (OAuth 2.0 — apps acting on behalf of a user)
#   3. JIRA_PAT                      (Data Center / Server)
#   4. OS keychain  (service=jira, account=$JIRA_BASE_URL)
#   5. Browser session  (auto-detected from your default browser)

JIRA_BASE_URL="https://your-site.atlassian.net"

# Cloud Basic
JIRA_EMAIL="you@company.com"
JIRA_API_TOKEN=""                # https://id.atlassian.com/manage-profile/security/api-tokens

# OAuth 2.0 (optional)
# JIRA_OAUTH_TOKEN=""
# JIRA_CLOUD_ID=""

# Data Center / Server (optional)
# JIRA_PAT=""
